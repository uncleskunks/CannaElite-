<!-- 
  CANNA ELITE — Live WooCommerce Product Fetch
  Paste this entire block right before </body> in canna-elite-final.html
-->
<script>
(async function() {

  const SITE     = 'https://wholesale.canna-elite.com';
  const CK       = 'ck_cab0dd3ea854d77b2be31caf3958859782fca9c3';
  const CS       = 'cs_06198d324cf2e79291d517d085172c7495dd0b4e';
  const PER_PAGE = 100;

  const grid = document.querySelector('.products-grid');
  if (!grid) { console.error('No .products-grid found'); return; }

  grid.innerHTML = '<p style="color:#c8a97e;text-align:center;padding:40px;grid-column:1/-1;">Loading products...</p>';

  try {
    const url = `${SITE}/wp-json/wc/v3/products?per_page=${PER_PAGE}&status=publish&consumer_key=${CK}&consumer_secret=${CS}`;
    const res  = await fetch(url);
    if (!res.ok) throw new Error(`API error ${res.status}`);
    const products = await res.json();

    if (!products.length) {
      grid.innerHTML = '<p style="color:#c8a97e;text-align:center;padding:40px;grid-column:1/-1;">No products found.</p>';
      return;
    }

    grid.innerHTML = products.map((p, i) => {

      const brand   = p.brands?.[0]?.name || 'Uncle Skunks';
      const name    = p.name || 'Untitled';
      const desc    = p.short_description
                        ? p.short_description.replace(/<[^>]+>/g, '').substring(0, 100)
                        : (p.description ? p.description.replace(/<[^>]+>/g, '').substring(0, 100) : '');
      const price   = p.price ? `$${parseFloat(p.price).toFixed(2)}` : 'Contact for price';
      const imgSrc  = p.images?.[0]?.src || '';
      const link    = p.permalink || '#';

      const thcAttr = p.attributes?.find(a => a.name.toLowerCase().includes('thc'));
      const badge   = thcAttr
                        ? `<div class="potency-badge">${thcAttr.options?.[0] || ''}</div>`
                        : (p.featured ? `<div class="potency-badge">Featured</div>` : '');

      const imgBlock = imgSrc
        ? `<img src="${imgSrc}" alt="${name}" style="width:100%;height:100%;object-fit:cover;">`
        : `<div class="pc-fallback" style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;color:#c8a97e;font-size:11px;letter-spacing:2px;">NO IMAGE</div>`;

      return `
        <div class="product-card reveal d${(i % 3) + 1}">
          <div class="pc-top-line"></div>
          <div class="pc-img">
            ${imgBlock}
            ${badge}
          </div>
          <div class="pc-body">
            <div class="pc-brand-lbl">${brand}</div>
            <div class="pc-name">${name}</div>
            <p class="pc-desc">${desc}</p>
            <div class="pc-footer">
              <span class="pc-price">${price}</span>
              <a href="${link}" target="_blank"><button class="pc-btn">View Options</button></a>
            </div>
          </div>
        </div>
      `;
    }).join('');

    console.log(`✅ Loaded ${products.length} live products from WooCommerce`);

  } catch (err) {
    console.error('WooCommerce fetch failed:', err);
    grid.innerHTML = `<p style="color:#c8a97e;text-align:center;padding:40px;grid-column:1/-1;">
      Could not load products.<br><small style="opacity:0.6;">${err.message}</small>
    </p>`;
  }

})();
</script>
